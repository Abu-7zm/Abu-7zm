-- ==========================================
-- ALPHA XK - V8 (Smart Rarity Scanner)
-- ==========================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Drawing = Drawing
local UserInputService = game:GetService("UserInputService")

local Rarities = {
    ["عادي"] = {Color = Color3.fromRGB(255, 255, 255), Keywords = {"عادي", "normal"}},
    ["مميز"] = {Color = Color3.fromRGB(0, 255, 0), Keywords = {"مميز", "premium"}},
    ["نادر"] = {Color = Color3.fromRGB(0, 150, 255), Keywords = {"نادر", "rare"}},
    ["فاخر"] = {Color = Color3.fromRGB(255, 0, 255), Keywords = {"فاخر", "luxury"}},
    ["اسطوري"] = {Color = Color3.fromRGB(255, 255, 0), Keywords = {"اسطوري", "legendary", "legend"}},
    ["خرافي"] = {Color = Color3.fromRGB(255, 0, 0), Keywords = {"خرافي", "mythical"}},
    ["خرافي نادر"] = {Color = Color3.fromRGB(255, 100, 100), Keywords = {"خرافي نادر", "mythical rare"}}
}

local SelectedRarity = "عادي"
local ESP_Enabled = false
local Aimbot_Enabled = false
local CarSpeed = 300
local CurrentTargets = {}

-- UI Creation
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AlphaHunterV8"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = game.CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 350, 0, 320)
MainFrame.Position = UDim2.new(0, 50, 0, 100)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.BorderSizePixel = 2
MainFrame.BorderColor3 = Color3.fromRGB(0, 255, 0)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Title.Text = "ALPHA XK - SMART HUNTER"
Title.TextColor3 = Color3.fromRGB(0, 255, 0)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 14
Title.Parent = MainFrame

local ToggleESP = Instance.new("TextButton")
ToggleESP.Size = UDim2.new(0.45, 0, 0, 25)
ToggleESP.Position = UDim2.new(0.03, 0, 0, 40)
ToggleESP.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ToggleESP.Text = "ESP: OFF"
ToggleESP.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleESP.Parent = MainFrame

local ToggleAimbot = Instance.new("TextButton")
ToggleAimbot.Size = UDim2.new(0.45, 0, 0, 25)
ToggleAimbot.Position = UDim2.new(0.52, 0, 0, 40)
ToggleAimbot.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ToggleAimbot.Text = "Aimbot: OFF"
ToggleAimbot.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleAimbot.Parent = MainFrame

local yPos = 75
local xPos = 0.03
for rarityName, data in pairs(Rarities) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.45, 0, 0, 25)
    btn.Position = UDim2.new(xPos, 0, 0, yPos)
    btn.BackgroundColor3 = data.Color
    btn.Text = rarityName
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = MainFrame
    
    btn.MouseButton1Click:Connect(function()
        SelectedRarity = rarityName
        MainFrame.BorderColor3 = data.Color
    end)
    
    if xPos == 0.03 then xPos = 0.52 else xPos = 0.03; yPos = yPos + 30 end
end

local SpeedBox = Instance.new("TextBox")
SpeedBox.Size = UDim2.new(0.9, 0, 0, 25)
SpeedBox.Position = UDim2.new(0.05, 0, 0, yPos + 10)
SpeedBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
SpeedBox.Text = "300"
SpeedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBox.Parent = MainFrame

SpeedBox.FocusLost:Connect(function() CarSpeed = tonumber(SpeedBox.Text) or 300 end)

ToggleESP.MouseButton1Click:Connect(function()
    ESP_Enabled = not ESP_Enabled
    ToggleESP.Text = "ESP: " .. (ESP_Enabled and "ON" or "OFF")
    ToggleESP.BackgroundColor3 = ESP_Enabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
end)

ToggleAimbot.MouseButton1Click:Connect(function()
    Aimbot_Enabled = not Aimbot_Enabled
    ToggleAimbot.Text = "Aimbot: " .. (Aimbot_Enabled and "ON" or "OFF")
    ToggleAimbot.BackgroundColor3 = Aimbot_Enabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
end)

local Tracers = {}
local function getTracer(index)
    if not Tracers[index] then
        Tracers[index] = Drawing.new("Line")
        Tracers[index].Thickness = 2
        Tracers[index].Transparency = 0.8
    end
    return Tracers[index]
end

-- Smart Scan Function
local function checkEntity(obj, keywords)
    local textsToCheck = {}
    table.insert(textsToCheck, obj.Name)
    if obj:FindFirstChild("Humanoid") and obj.Humanoid.DisplayName ~= "" then
        table.insert(textsToCheck, obj.Humanoid.DisplayName)
    end
    
    for k, v in pairs(obj:GetAttributes()) do table.insert(textsToCheck, tostring(k) .. tostring(v)) end
    for _, tag in pairs(obj:GetTags()) do table.insert(textsToCheck, tag) end
    for _, child in pairs(obj:GetChildren()) do
        if child:IsA("StringValue") or child:IsA("NumberValue") or child:IsA("IntValue") then
            table.insert(textsToCheck, tostring(child.Value))
        end
    end

    for _, text in pairs(textsToCheck) do
        local lowerText = string.lower(text)
        for _, keyword in pairs(keywords) do
            if string.find(lowerText, string.lower(keyword)) then return true end
        end
    end
    return false
end

-- Scan Loop
task.spawn(function()
    while task.wait(1.5) do
        if ESP_Enabled or Aimbot_Enabled then
            local foundTargets = {}
            local currentData = Rarities[SelectedRarity]
            
            if currentData then
                pcall(function()
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
                            local isPlayer = false
                            for _, plr in pairs(Players:GetPlayers()) do
                                if plr.Character == obj then isPlayer = true; break end
                            end
                            
                            if not isPlayer then
                                if checkEntity(obj, currentData.Keywords) then
                                    local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                                    if targetPart then
                                        table.insert(foundTargets, targetPart)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
            CurrentTargets = foundTargets
        else
            CurrentTargets = {}
        end
    end
end)

-- Render Loop
RunService.RenderStepped:Connect(function()
    for _, tracer in pairs(Tracers) do tracer.Visible = false end

    if ESP_Enabled and #CurrentTargets > 0 then
        local color = Rarities[SelectedRarity].Color
        for i, targetPart in ipairs(CurrentTargets) do
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local tracer = getTracer(i)
                tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                tracer.Color = color
                tracer.Visible = true
            end
        end
    end
    
    -- Aimbot
    if Aimbot_Enabled and #CurrentTargets > 0 then
        local closest = nil
        local shortest = math.huge
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, targetPart in ipairs(CurrentTargets) do
            local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local distToCenter = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if distToCenter < shortest then
                    shortest = distToCenter
                    closest = targetPart
                end
            end
        end

        if closest then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.2)
        end
    end
end)

-- Car Speed
local carVelocity = nil
task.spawn(function()
    while task.wait(0.1) do
        local seat = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("VehicleSeat")
        if seat and seat.Occupant == LocalPlayer.Character.Humanoid then
            local carModel = seat:FindFirstAncestorOfClass("Model") or seat.Parent
            local chassis = carModel.PrimaryPart or carModel:FindFirstChildWhichIsA("BasePart")
            
            if chassis then
                seat.MaxSpeed = CarSpeed
                if not carVelocity or carVelocity.Parent ~= chassis then
                    if carVelocity then carVelocity:Destroy() end
                    carVelocity = Instance.new("BodyVelocity")
                    carVelocity.Name = "AlphaCarSpeed"
                    carVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    carVelocity.P = 1250
                    carVelocity.Parent = chassis
                end
                carVelocity.Velocity = chassis.CFrame.LookVector * CarSpeed
            end
        else
            if carVelocity then carVelocity:Destroy(); carVelocity = nil end
        end
    end
end)
